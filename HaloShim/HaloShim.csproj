<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>halo</AssemblyName>
    <RootNamespace>HaloShim</RootNamespace>
    <Version>0.0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <SignAssembly>false</SignAssembly>
    <BuildHaloShim Condition="'$(BuildHaloShim)' == ''">false</BuildHaloShim>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>$(MSBuildProjectDirectory)\..\artifacts\HaloShim\</BaseOutputPath>
    <NebulousManagedDir Condition="'$(NebulousManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nebulous\Nebulous_Data\Managed</NebulousManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGMLIB\AGMLIB.csproj">
      <Aliases>agmlib</Aliases>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\AGMLIB\libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(NebulousManagedDir)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nebulous">
      <HintPath>$(NebulousManagedDir)\Nebulous.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ShapesRuntime">
      <HintPath>$(NebulousManagedDir)\ShapesRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(NebulousManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(NebulousManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NebulousManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(NebulousManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NebulousManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VFXModule">
      <HintPath>$(NebulousManagedDir)\UnityEngine.VFXModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target
    Name="BlockDisabledHaloShimBuild"
    BeforeTargets="PrepareForBuild"
    Condition="'$(BuildHaloShim)' != 'true'"
  >
    <Error Text="HaloShim is disabled. Pass -p:BuildHaloShim=true only for an intentional local POC build." />
  </Target>
</Project>
